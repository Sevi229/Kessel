function calculateWinRate(wins, losses, basedOnWins = true) {
    const total = wins + losses;
    if (total === 0) return 0; // Keine Win-Rate bei 0 Total
    return basedOnWins ? (wins / total) * 100 : (losses / total) * 100;
}

